{
  "permissions": {
    "allow": [
      "Bash(./mvnw:*)",
      "Bash(mvn:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-list:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git rev-parse:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(docker:*)",
      "mcp__github__create_issue",
      "mcp__github__create_pull_request",
      "mcp__github__add_issue_comment",
      "mcp__github__create_or_update_file",
      "mcp__github__push_files",
      "Edit(./.claude/stack.json)",
      "Write(./.claude/stack.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Edit(./.claude/factory.json)",
      "mcp__github__merge_pull_request",
      "Bash(gh pr merge:*)",
      "Bash(glab mr merge:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "factory-dev": {
      "source": {
        "source": "github",
        "repo": "babatop2313/factory-dev"
      }
    }
  },
  "enabledPlugins": {
    "factory@factory-dev": true
  }
}
