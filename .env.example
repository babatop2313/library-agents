# Modèle de configuration locale : copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.
# Aucune valeur par défaut n'existe pour les secrets : l'application refuse de démarrer s'ils manquent ou sont vides.
# Emplacement recommandé : la racine du dépôt (un seul .env).
# Format .properties : `NOM=valeur`, sans guillemets ni `export` ; doubler les `\` dans les chemins Windows.

# --- Obligatoires -----------------------------------------------------------------------------------------------
# Base PostgreSQL (installée sur le poste, port 5432). Utilisateur applicatif dédié, jamais le super-utilisateur.
DB_USER=
DB_PASSWORD=
# Clé de signature des JWT (HS256) : 32 octets minimum.
JWT_SECRET=

# --- Facultatives (valeurs par défaut non secrètes dans application.yml) ----------------------------------------
# DB_URL=jdbc:postgresql://localhost:5432/library
# Durée de vie du jeton et du cookie, au format ISO-8601 (défaut : PT1H).
# JWT_TTL=PT1H

# --- Redis (cache du catalogue) ---------------------------------------------------------------------------------
# Doit être défini hors profil `local` ; laisser vide si Redis n'a pas de mot de passe.
REDIS_PASSWORD=
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_SSL=false

# --- Amorçage du premier bibliothécaire (créé au démarrage seulement si aucun LIBRARIAN n'existe) ---------------
# Mot de passe : 12 caractères minimum. Absents : aucun compte créé (WARN au démarrage).
BOOTSTRAP_LIBRARIAN_EMAIL=
BOOTSTRAP_LIBRARIAN_PASSWORD=
