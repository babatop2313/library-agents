# Modèle des variables d'environnement : copier en .env (jamais commité) et renseigner chaque valeur.
# Utilisateur PostgreSQL de l'application (obligatoire, sinon refus de démarrer).
DB_USER=postgres
# Mot de passe PostgreSQL de l'application (obligatoire, sinon refus de démarrer).
DB_PASSWORD=postgres
# Clé de signature HS256 des jetons JWT, 32 octets minimum (obligatoire, sinon refus de démarrer).
JWT_SECRET=ELVCjfY1NAiiz4MBEo3Bw3rd8Rx44QqHEuNDSwQjCr4INeNh6Ri5Guzx0vQGnXLo
# Mot de passe Redis (vide autorisé en local uniquement, le profil local le fixe déjà à vide).
REDIS_PASSWORD=""
# E-mail du premier bibliothécaire, créé au démarrage seulement si aucun LIBRARIAN n'existe.
BOOTSTRAP_LIBRARIAN_EMAIL=admin@yomail.com
# Mot de passe du premier bibliothécaire, 12 caractères minimum.
BOOTSTRAP_LIBRARIAN_PASSWORD=P@sser123P@sser123
